<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <object class="AdwShortcutsSection">
        <property name="title">Walks</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Find a walk</property>
            <property name="accelerator">&lt;Primary&gt;Return</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Browse local stories</property>
            <property name="accelerator">&lt;Primary&gt;l</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Save the current walk as GPX</property>
            <property name="accelerator">&lt;Primary&gt;e</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Show or hide the walk planner</property>
            <property name="accelerator">F9</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Close map preview</property>
            <property name="accelerator">Escape</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title">Application</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Preferences</property>
            <property name="accelerator">&lt;Primary&gt;comma</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Show keyboard shortcuts</property>
            <property name="accelerator">question</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title">Quit</property>
            <property name="accelerator">&lt;Primary&gt;q</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
